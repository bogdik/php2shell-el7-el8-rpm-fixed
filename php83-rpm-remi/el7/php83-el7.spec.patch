--- a/php.spec
+++ b/php.spec
@@ -10,6 +10,10 @@
 #
 %if 0%{?scl:1}
 %scl_package php
+# Remi installs config and state outside the SCL root. %scl_package sets the
+# stock SCL paths, and a later %global replaces them.
+%global _sysconfdir /etc/opt/%{scl_vendor}/%{scl}
+%global _localstatedir /var/opt/%{scl_vendor}/%{scl}
 %else
 %global pkg_name          %{name}
 %global _root_sysconfdir  %{_sysconfdir}
@@ -204,6 +208,12 @@
 Patch48: php-8.3.0-openssl-ec-param.patch
 # Fix libidobc headers path
 Patch49: php-8.2.0-iodbc.patch
+# glibc _FORTIFY_SOURCE defines strncmp() as a macro; ZEND_STRL hides the comma
+Patch50: php-8.3.36-ffi-strncmp.patch
+# OpenSSL 1.0.2: ASN1_STRING_get0_data shim is static in openssl.c
+Patch51: php-8.3.36-openssl-asn1.patch
+# Official 8.3.36 still runs the upload-progress callback and stores the filename.
+Patch52: php-8.3.36-upload-progress-off.patch
 
 # RC Patch
 Patch91: php-7.2.0-oci8conf.patch
